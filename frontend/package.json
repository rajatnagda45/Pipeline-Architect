    "zustand": "^4.4.7"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:unit": "react-scripts test --watchAll=false --testPathPattern=\"__tests__/(parseVariables|nodeConfigs|store|TextField|SelectField|ToggleField)\"",
    "test:integration": "react-scripts test --watchAll=false --testPathPattern=\"__tests__/SubmitButton\"",
    "test:e2e": "playwright test",
    "test:all": "react-scripts test --watchAll=false && npm run test:e2e",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "msw": "^1.3.5"
  }
